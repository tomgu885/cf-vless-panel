{
  "name": "cf-vless-panel",
  "version": "0.1.0",
  "description": "Auditable Cloudflare Workers proxy panel",
  "directories": {
    "test": "test"
  },
  "scripts": {
    "dev": "wrangler dev --ip 127.0.0.1",
    "types": "wrangler types",
    "check": "wrangler types --check && tsc --noEmit",
    "test": "tsx --test test/core.test.ts",
    "build": "wrangler deploy --dry-run --outdir dist",
    "test:runtime": "npm run build && tsx --test test/runtime.test.ts",
    "format": "prettier --write src test *.json *.jsonc README.md",
    "format:check": "prettier --check src test *.json *.jsonc README.md",
    "test:interop": "npm run build && tsx test/interop.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tomgu885/cf-vless-panel.git"
  },
  "bugs": {
    "url": "https://github.com/tomgu885/cf-vless-panel/issues"
  },
  "homepage": "https://github.com/tomgu885/cf-vless-panel#readme",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "private": true,
  "dependencies": {
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "miniflare": "5.20261113.0-beta",
    "prettier": "3.10.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "wrangler": "4.162.0"
  }
}
